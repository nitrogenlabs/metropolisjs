{
  "name": "@nlabs/metropolisjs",
  "version": "1.7.1",
  "description": "Type-safe frontend integration for authentication, data, messaging, realtime events, billing, and Reaktor APIs.",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "exports": {
    "./api": {
      "types": "./lib/api/index.d.ts",
      "import": "./lib/api/index.js"
    },
    "./native-auth": {
      "types": "./lib/nativeAuth/index.d.ts",
      "import": "./lib/nativeAuth/index.js"
    },
    "./native-notifications/expo": {
      "types": "./lib/nativeNotifications/expo/index.d.ts",
      "import": "./lib/nativeNotifications/expo/index.js"
    },
    "./native-notifications": {
      "types": "./lib/nativeNotifications/index.d.ts",
      "import": "./lib/nativeNotifications/index.js"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./stores": {
      "types": "./lib/stores/index.d.ts",
      "import": "./lib/stores/index.js",
      "require": "./lib/stores/index.js"
    },
    "./actions": {
      "types": "./lib/actions/index.d.ts",
      "import": "./lib/actions/index.js",
      "require": "./lib/actions/index.js"
    },
    "./adapters": {
      "types": "./lib/adapters/index.d.ts",
      "import": "./lib/adapters/index.js",
      "require": "./lib/adapters/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "import": "./lib/utils/index.js",
      "require": "./lib/utils/index.js"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "import": "./lib/config/index.js",
      "require": "./lib/config/index.js"
    },
    "./session": {
      "types": "./lib/session/index.d.ts",
      "import": "./lib/session/index.js",
      "require": "./lib/session/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "lex compile --remove",
    "build:dev": "NODE_ENV=development lex compile --remove",
    "postbuild": "npx tsc-esm-fix lib",
    "clean": "lex clean",
    "dev": "lex dev --remove",
    "format": "npm run prettier && npm run lint",
    "lint": "lex lint --check --maxWarnings 0 && npm run lint:examples",
    "lint:examples": "eslint --config eslint.config.mjs \"examples/**/*.{ts,tsx}\" --max-warnings 0",
    "prettier": "prettier --write ./src",
    "production": "lex build",
    "publish:major": "npm version major && npm run publish:tags && npm publish",
    "publish:minor": "npm version minor && npm run publish:tags && npm publish",
    "publish:patch": "npm version patch && npm run publish:tags && npm publish",
    "publish:tags": "git push --tags && git push origin HEAD",
    "start": "lex dev -r -o",
    "test": "lex test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.examples.json && tsc -p tsconfig.native-auth.json --noEmit",
    "update": "lex update --interactive",
    "watch": "lex compile --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrogenlabs/metropolisjs.git"
  },
  "keywords": [
    "api-client",
    "arkhamjs",
    "authentication",
    "billing",
    "data-fetching",
    "frontend",
    "messaging",
    "nitrogenlabs",
    "react",
    "reaktor",
    "realtime",
    "server-sent-events",
    "session",
    "state-management",
    "typescript",
    "websocket"
  ],
  "author": {
    "name": "Giraldo Rosales",
    "email": "giraldo@nitrogenlabs.com",
    "url": "http://nitrogenlabs.com"
  },
  "license": "MIT",
  "homepage": "https://metropolisjs.nitrogenx.co",
  "bugs": {
    "url": "https://github.com/nitrogenlabs/metropolisjs/issues"
  },
  "dependencies": {
    "@nlabs/rip-hunter": "3.3.0",
    "@nlabs/utils": "^2.11.0",
    "i18next": "^26.4.3",
    "luxon": "^3.7.2",
    "p-debounce": "^5.1.1",
    "react-i18next": "^17.0.16",
    "sockette": "^2.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@nlabs/arkhamjs": "3.31.16",
    "@nlabs/arkhamjs-storage-browser": "^3.31.0",
    "@nlabs/arkhamjs-utils-react": "^3.33.0",
    "@nlabs/lex": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "expo-notifications": ">=0.31.0 <58",
    "@nlabs/arkhamjs": "^3.31.16",
    "@nlabs/arkhamjs-storage-browser": "^3.30.0",
    "@nlabs/arkhamjs-utils-react": "^3.32.0",
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "expo-notifications": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "cross-spawn": "^7.0.6",
    "got": "^14.6.5",
    "http-cache-semantics": "^4.2.0",
    "http-proxy-middleware": "^3.0.5",
    "micromark-extension-math": {
      "katex": "0.18.2"
    },
    "nth-check": "^2.1.1",
    "postcss": "^8.5.6",
    "postcss-url": {
      "minimatch": "^3.1.5"
    },
    "semver-regex": "^4.0.5"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "docs/GENERATION.md",
    "docs/ASSISTANT.md",
    "docs/NATIVE_NOTIFICATIONS.md",
    "docs/NATIVE_AUTH.md",
    "examples/native-notifications.ts"
  ]
}
