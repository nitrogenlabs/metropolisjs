{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@nlabs/metropolisjs": [
        "./src/index.tsx"
      ]
    },
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "lib",
    "node_modules"
  ],
  "include": [
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
