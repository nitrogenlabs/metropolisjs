{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "lib"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [
      "node",
      "vitest/globals"
    ]
  }
}
